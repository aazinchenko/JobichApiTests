    {
      "name": "03_CV Match API",
      "item": [
        {
          "name": "10 - Match CV via text",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.test('match response has scores and cvInfo', function () {",
                  "    pm.expect(j).to.have.property('matches').that.is.an('array');",
                  "    pm.expect(j).to.have.property('cvInfo');",
                  "    if (j.matches.length > 0) {",
                  "        pm.expect(j.matches[0]).to.have.property('fitScore').that.is.within(0, 100);",
                  "    }",
                  "});",
                  "if (j.matches && j.matches.length > 0) {",
                  "    pm.collectionVariables.set('happy_job_title_for_analyze', j.matches[0].title);",
                  "    pm.collectionVariables.set('happy_job_desc_for_analyze', j.matches[0].description || 'General role');",
                  "    pm.collectionVariables.set('happy_job_industry_for_analyze', 'Technology & IT');",
                  "    pm.collectionVariables.set('happy_job_location_for_analyze', j.matches[0].location || 'Zurich');",
                  "    pm.collectionVariables.set('happy_company_for_analyze', j.matches[0].company || 'Example AG');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Senior Software Engineer with 8 years of experience in Python, AWS, Docker, and Kubernetes. Based in Zurich.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/match",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "match"
              ]
            }
          },
          "response": []
        },
        {
          "name": "11 - Deep match analysis (CV + job pair)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('analysis returned with recommendation', function () {",
                  "    const j = pm.response.json();",
                  "    pm.expect(j.analysis).to.have.property('scores');",
                  "    pm.expect(['apply-strongly','apply-with-tailored-cv','apply-tactically','low-priority','do-not-apply']).to.include(j.analysis.recommendation);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cvText\": \"Senior Software Engineer with 8 years of experience in Python, AWS, Docker.\",\n  \"jobTitle\": \"Backend Engineer\",\n  \"jobDescription\": \"We need a Backend Engineer with Python and cloud experience.\",\n  \"jobIndustry\": \"Technology & IT\",\n  \"jobLocation\": \"Zurich\",\n  \"company\": \"Swiss Re\"\n}",
              "options": {
